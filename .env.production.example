POSTGRES_DB=semantix
POSTGRES_MIGRATION_USER=semantix_migrator
POSTGRES_MIGRATION_PASSWORD=replace-with-a-long-random-migration-password
POSTGRES_RUNTIME_USER=semantix_runtime
POSTGRES_RUNTIME_PASSWORD=replace-with-a-different-long-random-runtime-password
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_COMMAND_TIMEOUT_SECONDS=30

EMBEDDING_PROVIDER=mock
GENERATION_PROVIDER=mock
MOCK_EMBEDDING_DIMENSIONS=384
HF_API_KEY=
EVALUATION_TIMEOUT_SECONDS=300
EVALUATION_DATASET_MAX_CASES=50
EVALUATION_DATASET_MAX_DECODED_BYTES=49152
EVALUATION_MAX_WORKLOAD_QUERIES=250
EVALUATION_DATASET_STORAGE=session
EVALUATION_DATASET_MAX_PERSISTED_PER_NAMESPACE=100
EVALUATION_DATASET_DEFAULT_RETENTION_DAYS=30
EVALUATION_DATASET_MAX_RETENTION_DAYS=365
EVALUATION_DATASET_CLEANUP_BATCH_SIZE=100

# Aggregate run history is opt-in. If set to postgres, configure all three
# positive numeric settings below. History never stores per-query prompts or
# generated responses.
EVALUATION_RUN_HISTORY_STORAGE=disabled
EVALUATION_RUN_HISTORY_RETENTION_DAYS=
EVALUATION_RUN_HISTORY_MAX_PER_NAMESPACE=
EVALUATION_RUN_HISTORY_CLEANUP_BATCH_SIZE=

PROVIDER_MAX_RESPONSE_BYTES=4194304

AUTH_PRINCIPALS=[{"name":"admin","token_sha256":"replace-with-sha256-hex","role":"admin","namespaces":["*"]}]
ALLOWED_ORIGINS=["https://semantix.example.com"]
TRUSTED_PROXY_CIDRS=["172.28.0.0/24"]
MAX_REQUEST_BODY_BYTES=65536
RATE_LIMIT=20/minute
LOG_LEVEL=INFO

SEMANTIX_BIND_ADDRESS=127.0.0.1
SEMANTIX_PORT=8080
# Set to a private rule file outside the repository to trust a host TLS proxy.
SEMANTIX_HOST_PROXY_RULE_FILE=./apps/web/host-proxy.disabled.conf
# Optional private copy of the gateway upstream for planned replica drains.
SEMANTIX_UPSTREAM_FILE=./apps/web/upstream.prod.conf
