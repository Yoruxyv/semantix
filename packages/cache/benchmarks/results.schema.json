{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yoruxyv/semantix/benchmarks/results.schema.json",
  "title": "Embedded runtime trial evidence",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "environment",
    "dataset_sha256",
    "correctness_passed"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "runtime",
        "numerics",
        "failures",
        "postgresql"
      ]
    },
    "dataset_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "correctness_passed": {
      "type": "boolean"
    },
    "environment": {
      "type": "object",
      "required": [
        "source_revision",
        "runtime_source_sha256",
        "benchmark_source_sha256",
        "cpu",
        "ram_bytes",
        "os",
        "python",
        "versions",
        "blas_environment",
        "case",
        "process_topology",
        "measurement"
      ],
      "properties": {
        "source_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "runtime_source_sha256": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "ram_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "case": {
          "type": "object",
          "required": [
            "store",
            "workload",
            "dimensions",
            "cache_size",
            "capacity",
            "concurrency",
            "requests",
            "threshold",
            "ttl_seconds",
            "pool_size",
            "generation_delay",
            "seed",
            "duration",
            "diagnostics",
            "allocations",
            "profile",
            "worker_profile"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "runtime"
          }
        }
      },
      "then": {
        "required": [
          "operations",
          "elapsed_seconds",
          "operations_per_second",
          "latency_ms",
          "latencies_ns",
          "cache_hits",
          "cache_writes",
          "hit_ratio",
          "embedding_calls",
          "generation_calls",
          "duplicate_generation_count",
          "errors",
          "error_rate",
          "instrumented",
          "database",
          "rss",
          "cleanup_before_close"
        ],
        "properties": {
          "operations": {
            "type": "integer",
            "minimum": 0
          },
          "latencies_ns": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "latency_ms": {
            "type": "object",
            "required": [
              "p50",
              "p95",
              "p99",
              "max"
            ],
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "hit_ratio": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "numerics",
              "failures",
              "postgresql"
            ]
          }
        }
      },
      "then": {
        "required": [
          "metrics",
          "rss"
        ]
      }
    }
  ]
}
