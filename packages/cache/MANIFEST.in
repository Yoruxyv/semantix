include LICENSE README.md src/README.md
recursive-include src/semantix_cache *.py py.typed *.sql
recursive-include tests *.py
# Checkout-only benchmark/verifier tests require trees outside this distribution.
exclude tests/test_benchmark_harness.py
exclude tests/test_coalescing_benchmark.py
exclude tests/test_reuse_quality.py
exclude tests/test_reuse_quality_contracts.py
exclude tests/test_provider_live_verify.py
recursive-include examples *.py
